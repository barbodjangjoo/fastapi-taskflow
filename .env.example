# PostgreSQL Configuration
POSTGRES_DB=taskflow_db
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=secretpassword

# Database URL for SQLAlchemy with Psycopg 3
# In Docker Compose, host is 'db'. For local host development, use 'localhost'.
DATABASE_URL=postgresql+psycopg://taskflow_user:secretpassword@db:5432/taskflow_db
